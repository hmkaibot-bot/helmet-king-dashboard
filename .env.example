# ── Supabase ────────────────────────────────────────────────────────────
# anon key 係公開 key (可以放心入 bundle), 數據保護靠 RLS (sql/enable-rls.sql)。
# 唔設定嘅話會用 client/src/lib/config.ts 入面嘅預設值。
# ⚠️ 絕對唔好喺任何 VITE_ 變數放 service_role key — 佢會被打包入前端!
VITE_SUPABASE_URL=https://myrangmxyjamsupbxbba.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Foorir 客流系統 ──────────────────────────────────────────────────────
# 前端 CAPTCHA 登入用。本地開發放 .env, production 喺 Vercel 環境變數設定。
VITE_FOORIR_USERNAME=
VITE_FOORIR_PASSWORD=

# ── Shopify (推廣價同步 / 商品編輯, server-side only) ──────────────────────
# 全部喺 Vercel 環境變數設定; 絕對唔好用 VITE_ 前綴 (會入前端 bundle)。
SHOPIFY_SHOP=helmetking-0001.myshopify.com
# 建議: Dev Dashboard app — 用 Client ID + Secret 行 client credentials grant
# 即時換領 access token (需 write_products scope)。
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 或者 (二揀一): 舊式 admin custom app 嘅靜態 token。
# SHOPIFY_ADMIN_TOKEN=shpat_...
